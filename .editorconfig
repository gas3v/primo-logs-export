root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 читает кириллицу в скриптах только из UTF-8 с BOM
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
